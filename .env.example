TELEGRAM_BOT_TOKEN=seu_token_aqui

# Credenciais do my.telegram.org (Obrigatório para arquivos > 20MB usando Docker)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Para usar o Local Server, descomente e defina a URL base
# TELEGRAM_API_SERVER=http://localhost:8081

# Whitelist de IDs separados por vírgula (usuários ou grupos)
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=

DOWNLOAD_DIR=./media
DOWNLOAD_WORKERS=2
MAX_RETRIES=5
DEFAULT_FOLDER=outros
LOG_LEVEL=INFO


